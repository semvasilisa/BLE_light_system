cmake:
  application:
    source-dir: 'D:/ncs/v3.4.0/zephyr/share/sysbuild'
  board:
    name: 'nrf5340dk'
    path:
     - 'D:/ncs/v3.4.0/zephyr/boards/nordic/nrf5340dk'
    qualifiers: 'nrf5340/cpuapp'
    revision: ''
  images:
   - name: 'ble_light_project'
     source-dir: 'D:/projects/ble_light_project'
     type: 'MAIN'
  kconfig:
    files:
     - 'D:/projects/ble_light_project/build/_sysbuild/empty.conf'
     - 'D:/projects/ble_light_project/build/_sysbuild/empty.conf'
    user-files:
     - 'D:/projects/ble_light_project/build/_sysbuild/empty.conf'
  sysbuild: 'true'
version: '0.1.0'
west:
  command: 'C:\ncs\toolchains\dcbdc366a1\opt\bin\Scripts\west build --build-dir d:/projects/ble_light_project/build d:/projects/ble_light_project --pristine --board nrf5340dk/nrf5340/cpuapp -- -DCONFIG_DEBUG_THREAD_INFO=y'
  topdir: 'd:\ncs\v3.4.0'
  version: '1.5.0'
